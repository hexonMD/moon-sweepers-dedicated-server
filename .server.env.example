# Copy to .server.env and edit, or run python3 scripts/server_setup.py.
# Paths are absolute paths on Ubuntu. Never add your Steam account password.
MOON_GAME_SOURCE='/home/you/moon-sweepers/source/Moon Sweepers'
MOON_SERVER_PASSWORD=
# Optional GSLT for a persistent server Steam ID. Keep this secret; empty uses anonymous login.
MOON_STEAM_TOKEN=
# Optional additional player filter. Empty allows licensed players with the password.
MOON_ALLOWED_STEAM_IDS=
MOON_SLOT=1
# Steam GameServer API ports; joining uses the Steam ID, not IP:port.
MOON_GAME_PORT=27025
MOON_QUERY_PORT=27026
MOON_BACKUP_KEEP=10
TZ=America/Vancouver
